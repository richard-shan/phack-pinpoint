MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
# local path to the unzipped CoStar kit (too large for git)
COSTAR_KIT_DIR=
ANTHROPIC_API_KEY=
# Telegram caller bridge (loaded from .env, or export before launch)
TELEGRAM_BOT_TOKEN=
# Optional comma-separated private chat IDs; empty allows any private chat
TELEGRAM_ALLOWED_CHAT_IDS=
# Photon 2.0 Beta: server-side project key; never expose in browser code
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Optional receiving bot ID/phone handle and comma-separated caller handles
PHOTON_AGENT_HANDLE=
PHOTON_ALLOWED_HANDLES=
# 0: send one PDF through Photon in the original conversation (recommended)
# 1: Photon receives/replies; existing TELEGRAM_BOT_TOKEN sends approved Markdown documents
# Caller must have started a private chat with the existing packet bot too.
PHOTON_PACKET_VIA_TELEGRAM=0
